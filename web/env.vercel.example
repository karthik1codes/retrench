# =============================================================================
# Vercel → Project → Settings → Environment Variables
# (Production + Preview). Root vercel.json deploys service "web" from /web.
# Scout agent stays on EC2 — set SCOUT_AGENT_URL to that host.
# =============================================================================

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# After first deploy, set to https://YOUR_PROJECT.vercel.app (no trailing slash)
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# EC2 Signal Scout HTTP API (python -m signalscout serve --port 8787)
SCOUT_AGENT_URL=http://YOUR_EC2_PUBLIC_IP:8787
SCOUT_API_TOKEN=change-me
SCOUT_FALLBACK_DEMO=0
