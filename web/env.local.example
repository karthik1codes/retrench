# EC2 agent (from your laptop use an SSH tunnel if :8787 is not public)
#   ssh -L 8787:127.0.0.1:8787 ec2-user@YOUR_EC2_HOST
SCOUT_AGENT_URL=http://127.0.0.1:8787
SCOUT_API_TOKEN=change-me
SCOUT_FALLBACK_DEMO=0

# Auth.js — Google OAuth
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
