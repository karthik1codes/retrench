# Local: copy to web/.env.local
# Vercel: see .env.vercel.example + VERCEL_DEPLOY.md

# Agent HTTP API — local or EC2 :8787
SCOUT_AGENT_URL=http://127.0.0.1:8787
SCOUT_API_TOKEN=change-me
SCOUT_FALLBACK_DEMO=0
# SCOUT_AGENT_URL=http://YOUR_EC2_PUBLIC_IP:8787

# Auth.js — Google OAuth (+ Gmail)
# Deploy guide: VERCEL_DEPLOY.md | Google: GOOGLE_OAUTH_SETUP.md
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
