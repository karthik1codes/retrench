# Copy to .env.local (never commit .env.local or env)

# --- neatlogs (runtime) ---
# Ingest (agent SDK writes traces) — project API key
NEATLOGS_API_KEY=
# Public API reads (Retrench list/get traces) — service-account token
# Settings → Service Accounts → observability:read  (ingest key alone → 401)
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
NEATLOGS_BASE_URL=https://app.neatlogs.com
NEATLOGS_INGEST_ENDPOINT=https://ingest.neatlogs.com

# --- cfo.ai (money / Ari MCP) ---
CFO_AI_MCP_URL=https://api.cfo.ai/mcp
CFO_AI_ACCESS_TOKEN=
CFO_AI_ORG_ID=

# --- entire.io (change / sessions) ---
# Run `entire enable` in this repo; checkpoints live under .entire/
ENTIRE_REPO_PATH=.

# --- demo production agent (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- app ---
NEXT_PUBLIC_APP_NAME=Retrench
USE_MOCK_DATA=false

# --- AWS hackathon (console login only; prefer IAM roles on EC2) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
# Do not put IAM passwords in app env on servers — use instance role.
