# Copy to .env.local (never commit)

# CrustData
CRUSTDATA_API_KEY=

# neatlogs (LLM traces)
NEATLOGS_API_KEY=
NEATLOGS_INGEST_ENDPOINT=https://ingest.neatlogs.com

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Neo4j (use memory for offline tests)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=signalscout

# Agent HTTP API (EC2 or local serve)
SCOUT_API_TOKEN=change-me

# Optional AWS
AWS_REGION=us-east-1
SSM_PREFIX=/signalscout
SIGNAL_SCOUT_S3_BUCKET=
