[Unit]
Description=Signal Scout one cycle
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/signalscout
Environment=AWS_REGION=us-east-1
Environment=NEO4J_URI=bolt://localhost:7687
Environment=NEO4J_USER=neo4j
Environment=NEO4J_PASSWORD=signalscout
Environment=PYTHONPATH=/opt/signalscout/src
EnvironmentFile=-/opt/signalscout/.env.runtime
EnvironmentFile=-/opt/signalscout/.env.local
# Keep Neo4j up (ignore if compose plugin missing — neo4j may already be running)
ExecStartPre=-/usr/bin/docker start deploy-neo4j-1
ExecStart=/usr/bin/python3.11 -m signalscout run --config /opt/signalscout/segment.yaml
Nice=10

[Install]
WantedBy=multi-user.target
