[Unit]
Description=Signal Scout HTTP API for product UI
After=docker.service network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/signalscout
EnvironmentFile=-/opt/signalscout/.env.local
Environment=NEO4J_URI=bolt://localhost:7687
Environment=NEO4J_USER=neo4j
Environment=NEO4J_PASSWORD=signalscout
Environment=SCOUT_API_TOKEN=change-me
ExecStart=/usr/bin/python3.11 -m signalscout serve --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
